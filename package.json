{
  "name": "frankentower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "dev:offline": "vite --configLoader runner --host 127.0.0.1 --mode offline",
    "build": "tsc --noEmit && tsx scripts/validate-content.ts && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "balance": "tsx scripts/balance.ts",
    "format": "prettier --write",
    "test:browser": "node scripts/run-browser-checks.mjs",
    "test:hosted": "node scripts/hosted-check.mjs"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.29.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@revenuecat/purchases-js": "^1.70.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase": "^12.12.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
